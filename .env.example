# ============================================================
# Keep-Alive & Uptime Pinger — Environment Variables
# Copy this file to `.env` for local dev. On Render, set these
# in the Dashboard -> Your Service -> Environment tab.
# ============================================================

# Port that Render injects (Render sets PORT automatically).
PORT=3000

# Public URL of THIS app. Used by the self-pinger to keep the
# Render free instance awake by hitting /api/healthz every ~12 min.
# Example (Render): https://your-app.onrender.com
APP_URL=

# Master password for the dashboard login.
# Defaults to "ARAFAT168642" if not set (change it in production!).
AUTH_MASTER_KEY=ARAFAT168642

# Secret used to sign the auth JWT. If not set, one is derived
# from AUTH_MASTER_KEY + a random value (tokens then invalidate on restart).
JWT_SECRET=

# Optional MongoDB Atlas connection string.
# If set, targets/logs persist in MongoDB. If empty, falls back
# to a local JSON file (data/db.json) via lowdb.
MONGO_URI=
